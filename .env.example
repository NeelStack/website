# ─── Site URL ──────────────────────────────────────────────────────────────────
# Used by lib/site-url.ts for canonical URLs and metadata
NEXT_PUBLIC_SITE_URL=https://neelstack.com

# ─── Resend (Email API) ─────────────────────────────────────────────────────────
# Get your key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Contact Form Routing ───────────────────────────────────────────────────────
# Where contact/quote form submissions land
CONTACT_RECEIVER_EMAIL=contact@neelstack.com

# Must be a verified Resend sender domain (e.g. no-reply@neelstack.com)
CONTACT_SENDER_EMAIL=NeelStack Portal <no-reply@neelstack.com>

# ─── Search Console Verification ────────────────────────────────────────────────
# Google Search Console HTML tag token (optional for local dev, required for indexing verification)
GOOGLE_SITE_VERIFICATION=your_google_site_verification_token_here

# ─── IndexNow Search Engine Submission ──────────────────────────────────────────
# Bing & IndexNow API key for instant search engine indexing notifications
# Verification key file is hosted at public/<INDEXNOW_KEY>.txt
INDEXNOW_KEY=4efb3296786e407f973201563accd273
# Optional secret for triggering automated submissions via POST /api/indexnow
INDEXNOW_SECRET=your_indexnow_secret_here
